---
interface Props {
  fileId?: string | null;
  title?: string;
}

const { fileId, title } = Astro.props;
const href = fileId
  ? `${import.meta.env.PUBLIC_DIRECTUS_ENDPOINT}/assets/${fileId}?download`
  : null;
---

<style>
  .manuscript-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    padding: 0.4rem 0;
    font-family: "Montserrat", sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #999;
    border-bottom: 1px solid transparent;
    transition: color 0.2s, border-color 0.2s;
  }

  .manuscript-link:hover,
  .manuscript-link:focus-visible {
    color: #1a3a8a;
    border-bottom-color: currentColor;
  }

  .icon {
    width: 1.3rem;
    height: 1.3rem;
    flex: none;
  }
</style>

{href && (
  <a
    class="manuscript-link"
    href={href}
    aria-label={title ? `Download manuscript: ${title}` : "Download sermon manuscript"}
  >
    <svg class="icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M8 2v8M4.5 6.5 8 10l3.5-3.5M3 13.5h10" />
    </svg>
    Manuscript
  </a>
)}
