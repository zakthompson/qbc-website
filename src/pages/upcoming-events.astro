---
export const prerender = false;

import Layout from "../layouts/Layout.astro";
import SkewedBackground from "../components/SkewedBackground.astro";

const directusUrl = import.meta.env.PUBLIC_DIRECTUS_ENDPOINT;
const res = await fetch(`${directusUrl}/items/upcoming_events`);
const json = await res.json();
const rawContent = json.data?.content || '';
const content = rawContent.replace(/(src|href)="\/assets\//g, `$1="${directusUrl}/assets/`);
const featureImage = json.data?.feature_image || null;
const hasFeatureImage = !!featureImage;
const featureImageUrl = hasFeatureImage ? `${directusUrl}/assets/${featureImage}` : '';
---

<style>
  .hero-image {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 50vh;
    color: #fff;
    background-size: cover;
    background-position: center;
  }

  .overlay {
    background-color: rgba(80, 85, 90, 0.45);
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
  }

  .title-wrap {
    text-align: center;
    z-index: 1;
  }

  .title-stack {
    display: inline-flex;
    flex-direction: column;
    align-items: stretch;
  }

  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
  }

  .page-container.no-hero {
    padding-top: 120px;
  }

  .no-hero-title {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 30px;
  }

  .page-content {
    font-size: 1.8rem;
    line-height: 1.6;
    color: #555;
  }

  .page-content h1,
  .page-content h2,
  .page-content h3,
  .page-content h4,
  .page-content h5,
  .page-content h6 {
    color: #333;
    margin-top: 30px;
    margin-bottom: 15px;
  }

  .page-content p {
    margin-bottom: 20px;
  }

  .page-content ul,
  .page-content ol {
    margin-bottom: 20px;
    padding-left: 30px;
  }

  .page-content li {
    margin-bottom: 10px;
  }

  .page-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 20px 0;
  }

  .page-content blockquote {
    border-left: 4px solid #ddd;
    padding-left: 20px;
    margin: 20px 0;
    font-style: italic;
    color: #666;
  }

  .page-content a {
    color: #2b4170;
    text-decoration: underline;
  }

  .page-content a:hover {
    color: #1a2940;
  }

  @media only screen and (max-width: 768px) {
    .page-container {
      padding: 40px 15px;
    }

    .page-container.no-hero {
      padding-top: 120px;
    }

    .page-content {
      font-size: 1.6rem;
    }
  }
</style>

<Layout title="Upcoming Events | Queensway Baptist Church" pathname="/upcoming-events" hasHeroImage={hasFeatureImage}>
  {hasFeatureImage ? (
    <div class="hero-image" style={`background-image: url('${featureImageUrl}')`}>
      <div class="overlay"></div>
      <div class="title-wrap">
        <div class="title-stack">
          <SkewedBackground color="#1a3a8a" offset={-75}>
            <h1>Upcoming</h1>
          </SkewedBackground>
          <SkewedBackground color="#2d5fd3" offset={75}>
            <h1>Events</h1>
          </SkewedBackground>
        </div>
      </div>
    </div>
    <div class="page-container">
      <div class="page-content" set:html={content}></div>
    </div>
  ) : (
    <div class="page-container no-hero">
      <div class="no-hero-title">
        <div class="title-stack">
          <SkewedBackground color="#1a3a8a" offset={-75}>
            <h1>Upcoming</h1>
          </SkewedBackground>
          <SkewedBackground color="#2d5fd3" offset={75}>
            <h1>Events</h1>
          </SkewedBackground>
        </div>
      </div>
      <div class="page-content" set:html={content}></div>
    </div>
  )}
</Layout>
