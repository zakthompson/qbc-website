---
export const prerender = false;

import Layout from "../../layouts/Layout.astro";

interface CMSPage {
  id: string;
  name: string;
  content: string;
  slug: string;
  status: string;
}

const { collection, slug } = Astro.params;

// Validate parameters and fetch page data
async function fetchCMSPage(collection: string, slug: string): Promise<CMSPage | null> {
  const validCollections = ['ministries'];
  
  if (!collection || !slug || !validCollections.includes(collection)) {
    return null;
  }
  
  try {
    const fetchUrl = `${import.meta.env.PUBLIC_DIRECTUS_ENDPOINT}/items/${collection}?filter[slug][_eq]=${slug}&filter[status][_eq]=published&limit=1`;
    const res = await fetch(fetchUrl);
    
    if (!res.ok) {
      console.error('Fetch error:', res.status, res.statusText);
      return null;
    }
    
    const json = await res.json();
    
    if (json.data && json.data.length > 0) {
      const pageData = json.data[0];
      return {
        id: pageData.id || '',
        name: pageData.name || '',
        content: pageData.content || '',
        slug: pageData.slug || '',
        status: pageData.status || ''
      };
    }
    
    return null;
  } catch (error) {
    console.error('Error fetching page:', error);
    return null;
  }
}

const page = await fetchCMSPage(collection!, slug!);

// Redirect if page not found
if (!page) {
  return Astro.redirect('/404');
}

// Generate page title
const pageTitle = `${page.name} | Queensway Baptist Church`;
---

<style>
  .page-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 120px 20px 40px;
  }
  
  .page-title {
    font-size: 3.2rem;
    font-weight: 700;
    color: #333;
    margin-bottom: 30px;
    text-align: center;
  }
  
  .page-content {
    font-size: 1.8rem;
    line-height: 1.6;
    color: #555;
  }
  
  .page-content h1,
  .page-content h2,
  .page-content h3,
  .page-content h4,
  .page-content h5,
  .page-content h6 {
    color: #333;
    margin-top: 30px;
    margin-bottom: 15px;
  }
  
  .page-content p {
    margin-bottom: 20px;
  }
  
  .page-content ul,
  .page-content ol {
    margin-bottom: 20px;
    padding-left: 30px;
  }
  
  .page-content li {
    margin-bottom: 10px;
  }
  
  .page-content img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    margin: 20px 0;
  }
  
  .page-content blockquote {
    border-left: 4px solid #ddd;
    padding-left: 20px;
    margin: 20px 0;
    font-style: italic;
    color: #666;
  }
  
  .page-content a {
    color: #2b4170;
    text-decoration: underline;
  }
  
  .page-content a:hover {
    color: #1a2940;
  }
  
  @media only screen and (max-width: 768px) {
    .page-container {
      padding: 120px 15px 40px;
    }
    
    .page-title {
      font-size: 2.4rem;
    }
    
    .page-content {
      font-size: 1.6rem;
    }
  }
</style>

<Layout title={pageTitle} pathname={`/${collection}/${slug}`}>
  <div class="page-container">
    <h1 class="page-title">{page.name}</h1>
    <div class="page-content" set:html={page.content}></div>
  </div>
</Layout>